# Trainr.ai environment — copy to `.env.local` (gitignored) and fill in.
# Agents must NOT echo, check-for, or hard-fail on keys during dev; code reads
# from process.env and falls back to mocks when unset (USE_MOCKS / missing key).

# Anthropic (curriculum/compliance/coach)
ANTHROPIC_API_KEY=

# Tigris — S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=trainr

# RTRVR.ai — research/scraping
RTRVR_API_KEY=
RTRVR_BASE_URL=https://api.rtrvr.ai

# Opsera MCP — governance & deploy (used by IDE agent + optional server triggers)
OPSERA_MCP_URL=https://mcp.opsera.io/mcp
OPSERA_MCP_TOKEN=

# Insforge — DB/auth backend (⚠️ key not confirmed; Local fallback used until set)
INSFORGE_API_URL=
INSFORGE_API_KEY=
INSFORGE_PROJECT_ID=

# App
APP_BASE_URL=http://localhost:3000

# Global mock switch. 'true' = in-memory mock DB (fast for T2/T3 parallel dev).
# 'false' = persistent LocalRepository under .data/ (Track 1 owner flows + seed).
USE_MOCKS=false
