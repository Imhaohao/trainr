# Trainr.ai environment — copy to `.env.local` (gitignored) and fill in.
# Agents must NOT echo, check-for, or hard-fail on keys during dev; code reads
# from process.env and falls back to mocks when unset (USE_MOCKS / missing key).

# Anthropic (curriculum/compliance/coach)
ANTHROPIC_API_KEY=

# Tigris — S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://t3.storage.dev
AWS_REGION=auto
TIGRIS_BUCKET=trainr

# RTRVR.ai — research/scraping
RTRVR_API_KEY=
RTRVR_BASE_URL=https://api.rtrvr.ai

# Opsera MCP — governance & deploy (used by IDE agent + optional server triggers)
OPSERA_MCP_URL=https://mcp.opsera.io/mcp
OPSERA_MCP_TOKEN=

# Insforge — DB/auth backend. Real CRUD via PostgREST-style API.
# Selected by getDb() when USE_MOCKS!=='true' AND INSFORGE_API_KEY is set.
# NEVER put real keys in this example file — put them in .env.local (gitignored).
INSFORGE_API_URL=
INSFORGE_API_KEY=
INSFORGE_PROJECT_ID=
# Optional: table-name prefix in the Insforge `public` schema (default: trainr_)
INSFORGE_TABLE_PREFIX=trainr_

# Session signing secret for the httpOnly auth cookie (HMAC-SHA256).
# REQUIRED in production. Generate: `openssl rand -base64 32`
SESSION_SECRET=

# Google OAuth 2.0 (Authorization Code flow) — "Sign in with Google".
# Create a Web client at https://console.cloud.google.com/apis/credentials and
# register this Authorized redirect URI (must match APP_BASE_URL):
#   <APP_BASE_URL>/api/auth/google/callback
# The secret is used only server-side for the code->token exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
APP_BASE_URL=http://localhost:3000

# Global mock switch:
#   'true'           -> every adapter uses its in-memory mock (seeded demo).
#   unset / 'false'  -> each adapter uses its real impl when its key is present,
#                       else falls back (DB -> persistent LocalRepository).
# Demo note: owner login (xiao@happylemon-demo.com / demo1234) works out of the
# box with USE_MOCKS=true. On the Local backend, run `npm run seed` first.
USE_MOCKS=true
